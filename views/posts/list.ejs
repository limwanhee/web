<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <div class="text-end mb-2">
        <button class="btn btn-link px-5 btn-insert">글쓰기</button>
    </div>
    <table id="tbl" class="table table-striped table-hover"></table>
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
    <script id="temp" type="text/x-handlebars-template">
        <tbody>
        {{#each .}}
        <tr>
            <td>{{ID}}</td>
            <td><a href="/posts/{{ID}}">{{TITLE}}</a></td> <!-- posts/게시글 아이디 형식으로 제목 보내기 (게시글 읽기 위해 있는 것) -->
            <td>{{SNAME}}({{WRITER}})</td>
            <td class="text-end">{{FMT_DATE}}</td>
         </tr>
        {{/each}}
        </tbody>
    </script>
</div>
<script>
    let page=1;
    let size=5;
    getList();

    $(".btn-insert").on("click", function(){ //글쓰기 버튼 누르면
        if(scode){ //scode가 세션에 저장된게 있으면
            location.href='/posts/insert'; //글쓰기 페이지로 가라
        }else{ //없으면
            sessionStorage.setItem("target", "/posts/insert"); //target 세션에는 /posts/insert 저장해라
            location.href='/users/login'; // users/login으로 보내라
        }
    });

    $("#next").on("click", function(){ //다음 버튼 누르면
        page++; 
        getList();
    });

    $("#prev").on("click", function(){ //이전 버튼 누르면
        page--;
        getList();
    });

    function getList(){
        console.log(page, size);
        $.ajax({
            type:"get",
            url:"/posts/list.json", // posts/list.json으로 요청 보내고
            data:{page, size}, //page와 크기를 보낸다
            success:function(data) { //성공적으로 실행 됐으면
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data.list));
                const last = Math.ceil(data.total/size);
                $("#page").html(`${page}/${last}`);

                //1페이지에서 이전 버튼을 클릭한 경우
                if(page==1) 
                    $("#prev").attr("disabled", true); 
                else  
                    $("#prev").attr("disabled", false);
                //마지막 페에지에서 다음 버튼을 클릭한 경우
                if(page==last)
                    $("#next").attr("disabled", true); 
                else
                    $("#next").attr("disabled", false);
            }
        })
    }
</script>